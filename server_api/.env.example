APP_ENV=production
# python3 -c "import secrets; print(secrets.token_urlsafe(48))" ile üretin
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=postgresql://finance:finance@db:5432/finance
# Yapay zeka (varsayılan kapalı). Açarsanız docker-compose.yml içindeki notlara bakın.
AI_ENABLED=0
ANOMALY_SERVICE_URL=http://anomaly_api:5002/api/anomaly/check-transaction

# Gmail için "Uygulama Şifresi" kullanın (normal şifre çalışmaz)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Firebase Console > Proje Ayarları > Hizmet Hesapları > Yeni özel anahtar oluştur
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-credentials.json

# Gizlilik politikası ve hesap silme sayfalarında gösterilir
SUPPORT_EMAIL=

# Sunucunun dışarıdan erişilen adresi (şifre sıfırlama e-postasındaki bağlantı için)
PUBLIC_BASE_URL=https://api.alanadiniz.com

# Proxy arkasındaysa (Render, Nginx) 1; doğrudan internete açıksa 0
TRUSTED_PROXIES=1

# Zorunlu güncelleme (Android versionCode: pubspec "version: 1.0.0+KOD" içindeki KOD).
# Sunucuda eski uygulamayı bozan bir değişiklik yapınca MIN'i yeni sürümün koduna çekin.
MIN_APP_VERSION_CODE=1
# Yeni sürüm yayınlanınca artırın: eski sürümlere kapatılabilir "yeni sürüm var" önerisi
LATEST_APP_VERSION_CODE=1

# Bildirimle iki aşamalı doğrulama (v1: kapalı)
TWO_FACTOR_ENABLED=0
